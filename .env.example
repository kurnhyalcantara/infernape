# PostgreSQL
POSTGRES_USER=koer
POSTGRES_PASSWORD=secret
POSTGRES_DEFAULT_DB=koer
POSTGRES_PORT=5432

# Databases to create (comma-separated)
# Each service gets its own database on the shared Postgres instance
POSTGRES_DATABASES=araquanid,koer_cash_management,koer_product,koer_task,koer_tax,temtem

# Redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Kong Gateway (OSS)
KONG_VERSION=3.9
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002

# Kong control-plane database (dedicated, internal only)
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass
KONG_PG_DATABASE=kong

# Forward-auth target — araquanid is the source of truth for auth.
# Adjust host/port to match araquanid's actual /auth/verify endpoint.
AUTH_VERIFY_URL=http://araquanid:8080/auth/verify
