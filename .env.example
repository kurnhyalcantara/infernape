# PostgreSQL
POSTGRES_USER=koer
POSTGRES_PASSWORD=secret
POSTGRES_DEFAULT_DB=koer
POSTGRES_PORT=5432

# Databases to create (comma-separated)
# Each service gets its own database on the shared Postgres instance
POSTGRES_DATABASES=araquanid,koer_cash_management,koer_product,koer_task,koer_tax

# Redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
